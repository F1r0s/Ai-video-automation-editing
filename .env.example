# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — Copy to .env and fill in your real values
#  NEVER commit .env to GitHub
# ─────────────────────────────────────────────────────────────────────────────

# ── Output directories ────────────────────────────────────────────────────────
RAW_DIR=downloads/raw
EDITED_DIR=downloads/edited

# ── Video Constraints ─────────────────────────────────────────────────────────
MAX_DURATION=30

# ── ElevenLabs TTS ────────────────────────────────────────────────────────────
# Get key: https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice ID — find yours: https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── OpenAI (Whisper captions) ─────────────────────────────────────────────────
# Only needed if you use the API version instead of local Whisper
OPENAI_API_KEY=your_openai_api_key_here

# ── YouTube ────────────────────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs → Credentials → OAuth 2.0 Client IDs
YOUTUBE_CLIENT_SECRET=secrets/youtube_client_secret.json
YOUTUBE_TOKEN=secrets/youtube_token.json

# ── TikTok ────────────────────────────────────────────────────────────────────
# Requires TikTok Developer Account + Content Posting API access
# Docs: https://developers.tiktok.com/doc/content-posting-api-get-started
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# ── Instagram / Facebook ──────────────────────────────────────────────────────
# Both use the same Meta access token (long-lived page token)
# Guide: https://developers.facebook.com/docs/instagram-api/getting-started
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here
FACEBOOK_ACCESS_TOKEN=your_facebook_page_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# ── Instagram Playwright fallback (if Graph API unavailable) ──────────────────
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ── X (Twitter) ───────────────────────────────────────────────────────────────
# Create app: https://developer.twitter.com/en/portal/dashboard
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# ── yt-dlp cookies (optional, helps with age-restricted content) ───────────────
# Export from browser: https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp
YT_DLP_COOKIES=
